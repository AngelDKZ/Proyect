{
  "name": "mapa-riesgo-comunitario",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/build/copiar-worker-maplibre.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build/copiar-worker-maplibre.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
