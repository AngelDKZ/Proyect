    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:cargar": "tsx scripts/db/cargar-huaraz.ts",
    "datos:caminos": "tsx scripts/etl/huaico_caminos.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "maplibre-gl": "^6.19.0",
    "next": "16.4.6",
    "postgres": "^3.4.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "5.1.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^27.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vite": "7.3.8",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
