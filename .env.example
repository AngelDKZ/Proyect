# Copiar a .env y ajustar. Nunca subir .env al repositorio.

# Base de datos local (docker compose). En producción: cadena de conexión de Neon (región AWS).
DATABASE_URL=postgres://mapa:mapa_dev@localhost:5433/mapa_riesgo

# Variables usadas por docker-compose.yml (opcionales; estos son los valores por defecto)
POSTGRES_DB=mapa_riesgo
POSTGRES_USER=mapa
POSTGRES_PASSWORD=mapa_dev
POSTGRES_PORT=5433

# URL pública de la app (para enlaces y metadatos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
